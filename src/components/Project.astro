---
import Icon from "./Icon.astro";
import type { projects } from "../data/portfolio";

interface Props {
  project: (typeof projects)[number];
}

const { project } = Astro.props;
---

<a
  class="project"
  href={project.liveUrl}
  target="_blank"
  rel="noreferrer"
  aria-label={`Open ${project.name} live site`}
>
  <div class="project-art beforedoors-art" aria-hidden="true">
    <div class="door-art">
      <span class="door-label">VENUE ACCESS</span>
      <div class="door-frame">
        <div class="door-panel">
          <span></span>
        </div>
      </div>
      <strong>BeforeDoors</strong>
    </div>
    <span class="art-open">
      <Icon name="external" />
    </span>
  </div>
  <div class="project-caption">
    <div>
      <h3>{project.name}</h3>
      <p>
        {project.kind} · {project.event}
      </p>
    </div>
    <span>01</span>
  </div>
</a>
