---
import Editor from "../layouts/Editor.astro";
import { profile } from "../data/portfolio";
---

<Editor page="about">
  <div class="page prose-page">
    <div class="source-comment">// the person behind the pixels</div>
    <h1>
      A little about me<span class="green-text">.</span>
    </h1>
    <p class="lead">{profile.intro}</p>
    <div class="about-layout">
      <div>
        <h2>Equal parts logic and intuition.</h2>
        <p>
          I’m drawn to the space where design meets engineering. I enjoy taking
          a messy idea, finding the important part, and making it feel simple on
          the other side of a screen.
        </p>
        <p>
          My favorite work combines thoughtful typography, clear interactions,
          and code that someone else can comfortably pick up. I believe a good
          website should be fast, accessible, and a pleasure to use.
        </p>
        <h2>Away from the keyboard</h2>
        <p>
          You’ll usually find me collecting books I haven’t finished, taking the
          long way home, or searching for a really good cup of coffee. Curiosity
          tends to follow me everywhere.
        </p>
      </div>
      <aside class="code-note">
        <span>// about.json</span>
        <pre><span class="purple-text">{ '{' }</span>
  <span class="blue-text">"name"</span>: <span class="green-text">"{profile.name}"</span>,
  <span class="blue-text">"based_in"</span>: <span class="green-text">"Brooklyn"</span>,
  <span class="blue-text">"likes"</span>: [
    <span class="green-text">"thoughtful interfaces"</span>,
    <span class="green-text">"the open web"</span>,
    <span class="green-text">"a good side project"</span>
  ],
  <span class="blue-text">"learning"</span>: <span class="coral-text">true</span>
<span class="purple-text">{ '}' }</span></pre>
      </aside>
    </div>
    <section>
      <h2>Tools I reach for</h2>
      <div class="stack-list">
        {[
          "TypeScript",
          "Astro",
          "React",
          "CSS",
          "Node.js",
          "Figma",
          "Git",
          "Zed",
        ].map((t) => (
          <span>{t}</span>
        ))}
      </div>
    </section>
    <section id="colophon">
      <h2>About this little corner</h2>
      <p>
        This is an independent, Zed-inspired portfolio template, built with
        Astro and plain CSS. Fonts are Inter and JetBrains Mono, served locally.
        No trackers, no unnecessary framework runtime.
      </p>
      <p class="sample-note">
        This biography is sample content. Make it yours in{" "}
        <code>src/pages/about.astro</code> and{" "}
        <code>src/data/portfolio.ts</code>.
      </p>
    </section>
  </div>
</Editor>
