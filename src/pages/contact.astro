---
import Editor from "../layouts/Editor.astro";
import Icon from "../components/Icon.astro";
import { profile } from "../data/portfolio";
---

<Editor page="contact">
  <div class="page prose-page contact-page">
    <div class="source-comment">
      // every good thing starts with a conversation
    </div>
    <h1>
      Have something
      <br />
      in mind<span class="green-text">?</span>
    </h1>
    <p class="lead">A project, an idea, or just a hello. My inbox is open.</p>
    <div class="contact-email">
      <a href={`mailto:${profile.email}`}>
        {profile.email}
        <Icon name="external" size={26} />
      </a>
      <button
        class="icon-button"
        id="copy-email"
        data-email={profile.email}
        aria-label="Copy email address"
      >
        <Icon name="copy" size={20} />
      </button>
    </div>
    <p id="copy-status" role="status" class="copy-status"></p>
    <div class="contact-info">
      <div>
        <h2>Elsewhere on the internet</h2>
        <a
          class="text-link"
          href={profile.github}
          target="_blank"
          rel="noreferrer"
        >
          GitHub <Icon name="external" />
        </a>
      </div>
      <div>
        <h2>Currently</h2>
        <p class="availability">
          <span class="online-dot"></span>Open to interesting opportunities
        </p>
        <p>{profile.location}</p>
      </div>
    </div>
    <div class="code-note contact-code">
      <span>// no complicated forms, just a conversation</span>
      <pre><span class="purple-text">const</span> nextProject = &#123;
  <span class="blue-text">startsWith</span>: <span class="green-text">"a hello"</span>,
  <span class="blue-text">possibilities</span>: <span class="coral-text">Infinity</span>
&#125;;</pre>
    </div>
    <p class="sample-note">
      Template contact details — replace the email and social link before
      publishing.
    </p>
  </div>
</Editor>
