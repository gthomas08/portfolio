---
import Editor from "../layouts/Editor.astro";
import Icon from "../components/Icon.astro";
import { contactLinks } from "../data/portfolio";
---

<Editor page="contact">
  <div class="page prose-page resume-page contact-page">
    <div class="source-comment">// contact.json</div>
    <h1>
      Contact<span class="green-text">.</span>
    </h1>

    <div class="contact-json" role="group" aria-label="Social profile links">
      <span class="json-brace">&#123;</span>
      <div class="json-fields">
        {contactLinks.map((link, index) => (
          <div class="json-line">
            <span class="json-key">"{link.key}"</span>: <a
              class="external-text-link"
              href={link.url}
              target="_blank"
              rel="noreferrer"
              aria-label={`${link.label} profile (opens in a new tab)`}
              >"{link.url}" <Icon name="external" size={12} /></a
            >{index < contactLinks.length - 1 ? "," : ""}
          </div>
        ))}
      </div>
      <span class="json-brace">&#125;</span>
    </div>
  </div>
</Editor>
