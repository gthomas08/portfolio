---
import Editor from "../layouts/Editor.astro";
import Icon from "../components/Icon.astro";
import Project from "../components/Project.astro";
import {
  profile,
  experience,
  education,
  skillGroups,
  projects,
} from "../data/portfolio";
---

<Editor page="">
  <div class="page welcome-page">
    <div class="source-comment">
      <span class="line-number">01</span>
      <span>// profile</span>
    </div>

    <section class="hero">
      <div class="hello">
        <span class="tiny-cross">✳</span> {profile.name}
      </div>
      <h1>Software Engineer</h1>
      <p>
        Based in {profile.location}, I work on products across backend systems
        and architecture, building frontend and agentic AI features.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/skills/">
          Explore skills <Icon name="arrow" />
        </a>
        <a class="text-link" href="/experience/">
          Experience <Icon name="arrow" />
        </a>
        <a class="text-link" href="/education/">
          Education <Icon name="arrow" />
        </a>
      </div>
    </section>

    <section class="resume-section selected-work">
      <div class="section-heading">
        <h2>
          Projects
          <span class="count">
            {projects.length.toString().padStart(2, "0")}
          </span>
        </h2>
        <a href="/projects/">
          View project <Icon name="arrow" size={14} />
        </a>
      </div>
      <div class="project-grid">
        {projects.map((project) => (
          <Project project={project} />
        ))}
      </div>
    </section>

    <section class="resume-section">
      <div class="section-heading">
        <h2>
          Experience <span class="count">02</span>
        </h2>
        <a href="/experience/">
          View details <Icon name="arrow" size={14} />
        </a>
      </div>
      <div class="experience-list compact-list">
        {experience.map((job) => (
          <article class="experience-row">
            <div>
              <h3>{job.company}</h3>
              <p>{job.role}</p>
              {job.description && (
                <p class="experience-description">{job.description}</p>
              )}
            </div>
            <div class="resume-meta">
              <span>{job.dates}</span>
              <span>
                {job.location} · {job.arrangement}
              </span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="resume-section education-preview">
      <div class="section-heading">
        <h2>Education</h2>
        <a href="/education/">
          View details <Icon name="arrow" size={14} />
        </a>
      </div>
      <div class="education-row">
        <div>
          <h3>{education.degree}</h3>
          <p>
            {education.level} · {education.institution}
          </p>
        </div>
        <span class="resume-meta">{education.dates}</span>
      </div>
    </section>

    <section class="resume-section skills-preview">
      <div class="section-heading">
        <h2>Skills</h2>
        <a href="/skills/">
          View all <Icon name="arrow" size={14} />
        </a>
      </div>
      <div class="stack-list">
        {skillGroups.flatMap((group) => group.skills).map((skill) => (
          <span>{skill}</span>
        ))}
      </div>
    </section>

    <div class="page-foot">
      <span>{profile.name}</span>
      <span>
        Portfolio <span class="coral-text">✦</span>
      </span>
    </div>
  </div>
</Editor>
