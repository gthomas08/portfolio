---
import Editor from "../layouts/Editor.astro";
import { articles } from "../data/portfolio";
---

<Editor page="journal">
  <div class="page prose-page journal">
    <div class="source-comment">// notes from along the way</div>
    <h1>
      Thinking out loud<span class="green-text">.</span>
    </h1>
    <p class="lead">
      On building for the web, noticing the details, and staying curious.
    </p>
    <nav class="journal-index" aria-label="Journal entries">
      {articles.map((a) => (
        <a href={`#${a.id}`}>
          <span>{a.title}</span>
          <small>{a.date}</small>
        </a>
      ))}
    </nav>
    {articles.map((a) => (
      <article id={a.id}>
        <div class="article-meta">
          {a.date}
          <span>·</span>
          {a.tag}
        </div>
        <h2>{a.title}</h2>
        {a.body.split("\n\n").map((p) => (
          <p>{p}</p>
        ))}
      </article>
    ))}
    <p class="sample-note">
      Sample journal entries. Edit or replace these in{" "}
      <code>src/data/portfolio.ts</code>.
    </p>
  </div>
</Editor>
