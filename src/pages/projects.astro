---
import Editor from "../layouts/Editor.astro";
import Icon from "../components/Icon.astro";
import Project from "../components/Project.astro";
import { projects } from "../data/portfolio";
---

<Editor page="projects">
  <div class="page prose-page resume-page">
    <div class="source-comment">// projects</div>
    <h1>
      Projects<span class="green-text">.</span>
    </h1>
    <p class="lead">Selected work and hackathon submissions.</p>

    <div class="project-list">
      {projects.map((project) => (
        <article class="project-entry" id={project.id}>
          <Project project={project} />
          <p class="project-description">{project.description}</p>
          <nav class="project-links" aria-label={`${project.name} links`}>
            <a href={project.repositoryUrl} target="_blank" rel="noreferrer">
              GitHub <Icon name="external" size={13} />
            </a>
            <a href={project.eventUrl} target="_blank" rel="noreferrer">
              Hackathon <Icon name="external" size={13} />
            </a>
            <a href={project.liveUrl} target="_blank" rel="noreferrer">
              Live site <Icon name="external" size={13} />
            </a>
          </nav>
        </article>
      ))}
    </div>
  </div>
</Editor>
